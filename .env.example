# ============================================================
# XYON Command Centre — Environment Variables
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file and rename it to ".env" (no .example)
#   2. Fill in every value below with your real credentials
#   3. NEVER share this file or commit it to git
# ============================================================

# --- META (Facebook/Instagram Ads) --------------------------
# Get these from: developers.facebook.com → Your App → System Users
META_ACCESS_TOKEN=your_system_user_token_here
META_AD_ACCOUNT_ID=act_XXXXXXXXXXXXXXXXX
META_APP_ID=your_app_id_here

# --- TIKTOK ADS ---------------------------------------------
# Get these from: ads.tiktok.com → Tools → TikTok for Developers
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here
TIKTOK_ADVERTISER_ID=your_tiktok_advertiser_id_here

# --- REDDIT ADS ---------------------------------------------
# Get these from: reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_AD_ACCOUNT_ID=your_reddit_account_id_here
REDDIT_USERNAME=your_reddit_username_here

# --- SERVER -------------------------------------------------
PORT=3000
