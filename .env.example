# ===========================================
# XYON Command Centre — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the .env file to git.
# ===========================================

# --- Meta (Facebook) Marketing API ---
META_ACCESS_TOKEN=your_token_here
META_AD_ACCOUNT_ID=act_XXXXXXXXX
META_APP_ID=your_app_id

# --- TikTok Ads API ---
TIKTOK_ACCESS_TOKEN=your_token_here
TIKTOK_ADVERTISER_ID=your_advertiser_id

# --- Reddit Ads API ---
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_secret
REDDIT_AD_ACCOUNT_ID=your_account_id

# --- Reddit Organic Listening (read-only social listening) ---
# Create a "script" type app at https://www.reddit.com/prefs/apps
# This is separate from the Ads API above and only READS public posts/comments.
REDDIT_SCAN_CLIENT_ID=your_script_app_id
REDDIT_SCAN_SECRET=your_script_app_secret
REDDIT_USER_AGENT=xyon-listener/1.0 by u/yourusername

# --- Server ---
PORT=3000
