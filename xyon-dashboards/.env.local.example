# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored, so your secrets never get pushed.

# The spreadsheet that receives the BigQuery feed (the ID is the long
# string between /d/ and /edit in the sheet's URL).
DATA_SHEET_ID=paste_the_feed_sheet_id_here

# The spreadsheet holding the Tokens tab. If you added the Tokens tab
# to the feed sheet itself, use the same ID for both.
TOKENS_SHEET_ID=paste_the_tokens_sheet_id_here

# Your service account JSON key, base64-encoded into one line.
# Mac/Linux: base64 -i ~/Downloads/your-key-file.json
# Share BOTH sheets above with the service account email as Viewer.
GOOGLE_SERVICE_ACCOUNT_KEY_B64=paste_your_long_base64_string_here
