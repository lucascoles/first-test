# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored, so your secrets never get pushed.

# The spreadsheet holding the Tokens tab (the ID is the long string
# between /d/ and /edit in the sheet's URL).
TOKENS_SHEET_ID=paste_the_tokens_sheet_id_here

# Your service account JSON key, base64-encoded into one line.
# Mac/Linux: base64 -i ~/Downloads/your-key-file.json
#
# The service account needs:
#   - the Tokens sheet shared with it as Viewer
#   - "BigQuery Job User" in ITS OWN project (queries are billed there,
#     so also enable the BigQuery API in that project)
#   - "BigQuery Data Viewer" on the reporting dataset in
#     xyon-growth-production (granted by whoever admins that project)
GOOGLE_SERVICE_ACCOUNT_KEY_B64=paste_your_long_base64_string_here
